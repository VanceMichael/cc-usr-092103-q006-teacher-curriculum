{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "能力证据材料",
  "type": "object",
  "required": [
    "domain",
    "version",
    "sample_id",
    "evidence"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "student_ref",
          "cohort",
          "plan_id",
          "type",
          "ref_id",
          "competencies",
          "summary",
          "privacy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "student_ref": {
            "type": "string",
            "minLength": 1
          },
          "cohort": {
            "type": "integer",
            "minimum": 2000
          },
          "plan_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "course_record",
              "tool_demo",
              "internship_task",
              "mentor_observation",
              "postgrad_training"
            ]
          },
          "ref_id": {
            "type": "string",
            "minLength": 1
          },
          "competencies": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "privacy": {
            "type": "string",
            "enum": [
              "student_level"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
