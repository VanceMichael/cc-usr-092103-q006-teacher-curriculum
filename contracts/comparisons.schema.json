{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "十国比较维度与借鉴条件",
  "type": "object",
  "required": [
    "domain",
    "version",
    "dimensions",
    "local_context",
    "countries",
    "cases"
  ],
  "properties": {
    "domain": {
      "const": "teacher-curriculum"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key",
          "label"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "local_context": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "dimensions"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "dimensions": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "country",
          "title",
          "requires"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "requires": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "dimension"
              ],
              "properties": {
                "dimension": {
                  "type": "string",
                  "minLength": 1
                },
                "equals": {},
                "min": {
                  "type": "number"
                },
                "in": {
                  "type": "array",
                  "minItems": 1
                },
                "critical": {
                  "type": "boolean"
                }
              },
              "anyOf": [
                {
                  "required": [
                    "equals"
                  ]
                },
                {
                  "required": [
                    "min"
                  ]
                },
                {
                  "required": [
                    "in"
                  ]
                }
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
