{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "十国比较维度与本校制度背景",
  "type": "object",
  "required": [
    "domain",
    "version",
    "sample_id",
    "local_context",
    "cases"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "local_context": {
      "type": "object",
      "required": [
        "qualification",
        "credit_system",
        "practicum",
        "governance"
      ],
      "properties": {
        "qualification": {
          "type": "string",
          "minLength": 1
        },
        "credit_system": {
          "type": "string",
          "minLength": 1
        },
        "practicum": {
          "type": "string",
          "minLength": 1
        },
        "governance": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "country",
          "ai_course_strategy",
          "dimensions",
          "borrow_conditions",
          "note"
        ],
        "properties": {
          "country": {
            "type": "string",
            "minLength": 1
          },
          "ai_course_strategy": {
            "type": "string",
            "enum": [
              "integrated",
              "standalone",
              "standalone_plus_integration"
            ]
          },
          "dimensions": {
            "type": "object",
            "required": [
              "qualification",
              "credit_system",
              "practicum",
              "governance"
            ],
            "properties": {
              "qualification": {
                "type": "string",
                "minLength": 1
              },
              "credit_system": {
                "type": "string",
                "minLength": 1
              },
              "practicum": {
                "type": "string",
                "minLength": 1
              },
              "governance": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "borrow_conditions": {
            "type": "object"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
