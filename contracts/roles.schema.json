{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "角色与权限范围",
  "type": "object",
  "required": [
    "domain",
    "version",
    "sample_id",
    "roles"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "review_scope",
          "student_data"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "review_scope": {
            "type": "object",
            "required": [
              "plan_ids"
            ],
            "properties": {
              "plan_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "student_data": {
            "type": "string",
            "enum": [
              "masked",
              "pseudonymous"
            ]
          },
          "course_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "assigned_students": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
