{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "历次培养方案与学分规则变化",
  "type": "object",
  "required": [
    "domain",
    "version",
    "sample_id",
    "plans",
    "credit_rule_changes"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "cohort",
          "title",
          "credits",
          "ai_strategy",
          "required_competencies",
          "objectives"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "cohort": {
            "type": "integer",
            "minimum": 2000
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "credits": {
            "type": "object",
            "required": [
              "total",
              "practice"
            ],
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 1
              },
              "practice": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "ai_strategy": {
            "type": "string",
            "enum": [
              "integrated",
              "standalone",
              "standalone_plus_integration"
            ]
          },
          "required_competencies": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "objectives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "credit_rule_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from_plan",
          "to_plan",
          "field",
          "from",
          "to",
          "applies_to_cohorts",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from_plan": {
            "type": "string",
            "minLength": 1
          },
          "to_plan": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "integer",
            "minimum": 0
          },
          "to": {
            "type": "integer",
            "minimum": 0
          },
          "applies_to_cohorts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 2000
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
