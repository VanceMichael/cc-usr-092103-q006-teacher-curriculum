{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "校内课程目录",
  "type": "object",
  "required": [
    "domain",
    "version",
    "sample_id",
    "courses"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "courses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "credits",
          "kind",
          "ai_mode",
          "plans",
          "supports"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "credits": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "course",
              "internship"
            ]
          },
          "ai_mode": {
            "type": "string",
            "enum": [
              "none",
              "standalone",
              "integrated_ai"
            ]
          },
          "plans": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "competency",
                "channel"
              ],
              "properties": {
                "competency": {
                  "type": "string",
                  "minLength": 1
                },
                "channel": {
                  "type": "string",
                  "enum": [
                    "knowledge",
                    "practice",
                    "mentor",
                    "development"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
